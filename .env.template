# PostgreSQL (in Docker Compose the same values create the database)
HOST=localhost
PORT=5432
DATABASE=monitoring
DB_USERNAME=postgres
PASSWORD=

# Redis: cache for finance lists
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT. Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Steam. Every key must be present for the backend to start; STEAM_API_KEY may stay empty if Steam is not used.
# BASE_URL and RETURN_STEAM_URL point to the frontend: http://127.0.0.1:5173/ in dev, http://localhost/ in Docker.
STEAM_API_KEY=
BASE_URL=http://127.0.0.1:5173/
RETURN_STEAM_URL=http://127.0.0.1:5173/steam/auth/callback/
STEAM_OPENID_URL=https://steamcommunity.com/openid/login
STEAM_PROFILE_INFO_URL=https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v0002/
STEAM_PROFILE_GAMES_URL=https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/
STEAM_PROFILE_RECENT_GAMES=https://api.steampowered.com/IPlayerService/GetRecentlyPlayedGames/v0001/
STEAM_PROFILE_GAMES_ACHIEVEMENTS=https://api.steampowered.com/ISteamUserStats/GetPlayerAchievements/v0001/
STEAM_PROFILE_GAMES_NEWS=https://api.steampowered.com/ISteamNews/GetNewsForApp/v0002/

# Telegram bot (optional)
BOT_TOKEN=
APP_API=
